# ------------------------------------------------------------------------------
# Home-ERP Environment Configuration Template
# ------------------------------------------------------------------------------

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-dev-insecure-key-change-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (supabase/postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_erp
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/home_erp

# Redis (Cache & Celery Broker)
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# SeaweedFS (S3 Object Storage)
AWS_ACCESS_KEY_ID=home_erp_key
AWS_SECRET_ACCESS_KEY=home_erp_secret
AWS_STORAGE_BUCKET_NAME=home-erp-media
AWS_S3_ENDPOINT_URL=http://127.0.0.1:8333

# Server / Nginx
PORT=80
